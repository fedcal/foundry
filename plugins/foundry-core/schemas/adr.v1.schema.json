{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcal.github.io/foundry/schemas/adr.v1.schema.json",
  "title": "Architecture decision record",
  "description": "A decision, its drivers, the options weighed and the consequences accepted.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "adr.v1"
    },
    "producedBy": {
      "type": "string",
      "description": "agent name that produced this artifact"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "deciders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "string"
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "pros",
          "cons"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "pros": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cost": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "type": "string"
    },
    "consequences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "supersedes": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "schema",
    "producedBy",
    "number",
    "title",
    "status",
    "date",
    "context",
    "options",
    "decision"
  ]
}
