{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcal.github.io/foundry/schemas/plan.v1.schema.json",
  "title": "Execution plan",
  "description": "Wave-based plan with explicit gates, produced before implementation.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "plan.v1"
    },
    "producedBy": {
      "type": "string",
      "description": "agent name that produced this artifact"
    },
    "goal": {
      "type": "string"
    },
    "waves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tasks",
          "gate"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "description",
                "agent"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "agent": {
                  "type": "string"
                },
                "dependsOn": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "estimateHours": {
                  "type": "number"
                },
                "isolation": {
                  "type": "string",
                  "enum": [
                    "none",
                    "worktree"
                  ]
                }
              }
            }
          },
          "gate": {
            "type": "object",
            "description": "Machine-checkable exit criteria for the wave."
          }
        }
      }
    },
    "rollback": {
      "type": "string"
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "producedBy",
    "goal",
    "waves"
  ]
}
