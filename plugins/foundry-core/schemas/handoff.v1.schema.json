{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedcal.github.io/foundry/schemas/handoff.v1.schema.json",
  "title": "Wave handoff",
  "description": "What one wave passes to the next. Enforces the context firewall.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "handoff.v1"
    },
    "producedBy": {
      "type": "string",
      "description": "agent name that produced this artifact"
    },
    "wave": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "schema"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 1200,
      "description": "<= 300 tokens. The ONLY narrative that crosses into the parent context."
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockedBy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tokensSpent": {
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "producedBy",
    "wave",
    "status",
    "artifacts",
    "summary"
  ]
}
