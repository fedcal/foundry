{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: loading project state",
            "timeout": 15,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: recalling relevant memory",
            "timeout": 20,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/prompt-context.mjs"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: checking command safety",
            "timeout": 15,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard-bash.mjs"
            ]
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: scanning for secrets and protected paths",
            "timeout": 15,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard-write.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: validating contract",
            "timeout": 20,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/validate-contract.mjs"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: enforcing context firewall",
            "timeout": 15,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-firewall.mjs"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: verifying completion claims",
            "timeout": 25,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop-verify.mjs"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Foundry: persisting session learnings",
            "timeout": 20,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/precompact-persist.mjs"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/session-end.mjs"
            ]
          }
        ]
      }
    ]
  }
}
