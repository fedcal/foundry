{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "foundry-oss",
  "displayName": "Foundry OSS Governance",
  "version": "0.1.0",
  "description": "Open source governance: contribution workflow, RFC process, issue triage, security policy, semantic versioning and release communication.",
  "author": {
    "name": "Federico Calò",
    "url": "https://federicocalo.dev"
  },
  "homepage": "https://fedcal.github.io/foundry",
